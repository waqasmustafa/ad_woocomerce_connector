<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="report_invoice_document_wc_discount" inherit_id="account.report_invoice_document">
        <xpath expr="//t[@t-set='display_discount']" position="after">
            <t t-set="display_wc_discount" t-value="any(l.wc_discount_amount for l in o.invoice_line_ids)"/>
            <t t-set="display_wc_actual_price" t-value="any(l.wc_actual_price for l in o.invoice_line_ids)"/>
        </xpath>
        <xpath expr="//th[@name='th_priceunit']/span" position="replace">
            <span>Sale Price</span>
        </xpath>
        <xpath expr="//th[@name='th_priceunit']" position="before">
            <th name="th_wc_actual_price" t-if="display_wc_actual_price" t-attf-class="text-end text-nowrap {{ 'd-none d-md-table-cell' if report_type == 'html' else '' }}">
                <span>Regular Price</span>
            </th>
        </xpath>
        <xpath expr="//td[@name='td_price_unit']" position="before">
            <td name="td_wc_actual_price" t-if="display_wc_actual_price" t-attf-class="text-end {{ 'd-none d-md-table-cell' if report_type == 'html' else '' }}">
                <span class="text-nowrap" t-field="line.wc_actual_price">0</span>
            </td>
        </xpath>
        <xpath expr="//th[@name='th_discount']" position="before">
            <th name="th_wc_discount" t-if="display_wc_discount" t-attf-class="text-end {{ 'd-none d-md-table-cell' if report_type == 'html' else '' }}">
                <span>Discount</span>
            </th>
        </xpath>
        <xpath expr="//td[@name='td_discount']" position="before">
            <td name="td_wc_discount" t-if="display_wc_discount" t-attf-class="text-end {{ 'd-none d-md-table-cell' if report_type == 'html' else '' }}">
                <span class="text-nowrap" t-field="line.wc_discount_amount">0</span>
            </td>
        </xpath>
        <xpath expr="//t[@t-call='account.document_tax_totals']/t[@t-set='tax_totals']" position="after">
            <t t-set="tax_totals" t-value="dict(tax_totals, wc_total_discount=sum(o.invoice_line_ids.mapped('wc_discount_amount')))"/>
        </xpath>
        <xpath expr="//p[@name='payment_communication']" position="after">
            <p name="wc_query_contact_note">In case of any query, please contact us within 24 hours.</p>
        </xpath>
    </template>

    <template id="document_tax_totals_wc_discount" inherit_id="account.document_tax_totals_template">
        <xpath expr="//tr[hasclass('o_total')]" position="before">
            <tr t-if="tax_totals.get('wc_total_discount')" class="o_subtotal">
                <td>
                    <span>Total Discount</span>
                </td>
                <td class="text-end">
                    <span t-out="tax_totals.get('wc_total_discount')" t-options="{&quot;widget&quot;: &quot;monetary&quot;, &quot;display_currency&quot;: currency}">0</span>
                </td>
            </tr>
        </xpath>
    </template>

</odoo>
